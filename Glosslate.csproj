<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>

    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64;osx-arm64</RuntimeIdentifiers>

    <AssemblyName>Glosslate</AssemblyName>
    <RootNamespace>Glosslate</RootNamespace>
    <Product>Glosslate</Product>
    <Authors>TamKungZ_</Authors>
    <Company>TamKungZ_</Company>
    <Copyright>Copyright © TamKungZ_</Copyright>
    <Description>Cross-platform glossary-aware translation tool for flat JSON localization files.</Description>
    <PackageProjectUrl>https://dev.tamkungz.me</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TamKungZ/Glosslate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets/app.ico</ApplicationIcon>

    <EtoBackend Condition="'$(EtoBackend)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Wpf</EtoBackend>
    <EtoBackend Condition="'$(EtoBackend)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Gtk</EtoBackend>
    <EtoBackend Condition="'$(EtoBackend)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">Mac64</EtoBackend>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Eto.Forms" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(EtoBackend)' == 'Wpf'">
    <PackageReference Include="Eto.Platform.Wpf" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(EtoBackend)' == 'Gtk'">
    <PackageReference Include="Eto.Platform.Gtk" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(EtoBackend)' == 'Mac64'">
    <PackageReference Include="Eto.Platform.Mac64" Version="2.11.0" />
  </ItemGroup>

  <Target Name="ValidateEtoBackend" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(EtoBackend)' != 'Wpf' and '$(EtoBackend)' != 'Gtk' and '$(EtoBackend)' != 'Mac64'"
      Text="Unsupported or undetected Eto backend '$(EtoBackend)'. Use Wpf, Gtk, or Mac64 via -p:EtoBackend=&lt;backend&gt;." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="Glosslate.Assets.app.ico" />
    <EmbeddedResource Include="Assets/app.png" LogicalName="Glosslate.Assets.app.png" />
    <Content Include="Assets/app.icns">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>